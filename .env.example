# AI 配置
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=your_key_here
AI_MODEL=glm-4

# 通知配置 - Telegram
NOTIFY_TELEGRAM_BOT_TOKEN=your_bot_token
NOTIFY_TELEGRAM_CHAT_ID=your_chat_id

# 代理配置（国内访问 Telegram 可能需要）
# HTTP_PROXY=http://127.0.0.1:7890

# SSL 企业证书（Zscaler 等企业代理环境需要，留空则不启用）
# CA_CERT_FILE=/path/to/your/enterprise-cert.crt

# 调度配置（cron 表达式：分 时 日 月 周）
DAILY_REPORT_CRON=30 15 * * 1-5

# PriceDog Rust Engine
PANWATCH_PORT=18000
PRICE_ACTION_ENGINE_URL=http://127.0.0.1:8001
PA_ENGINE_PORT=8001
AKSHARE_ADAPTER_URL=http://127.0.0.1:8002
# Docker Compose 内部默认使用 http://akshare-adapter:8002，adapter 不暴露到宿主机。
PA_CRYPTO_WS_ENABLED=true
PA_CRYPTO_WS_SYMBOLS=BTCUSDT,ETHUSDT
PA_CRYPTO_WS_INTERVALS=5m,1h,4h
PA_CRYPTO_BACKFILL_ENABLED=true
PA_CRYPTO_BACKFILL_INTERVAL_SEC=60
PA_CRYPTO_BACKFILL_LOOKBACK=120

# PostgreSQL storage
# Docker Compose starts PostgreSQL as a shared infrastructure service.
# Other services can use the same postgres service with their own DATABASE_URL.
PANWATCH_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/pricedog
PA_DATABASE_URL=postgres://postgres:postgres@postgres:5432/pricedog
POSTGRES_DB=pricedog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=15432

# Docker 轻量化开关
# 默认关闭截图浏览器和 TradingAgents 深度分析依赖，保持监控服务轻量。
INSTALL_SCREENSHOT=false
INSTALL_TRADINGAGENTS=false
PLAYWRIGHT_SKIP_BROWSER_INSTALL=1
